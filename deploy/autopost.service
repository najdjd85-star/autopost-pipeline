[Unit]
Description=3-Site Passive Media Pipeline (autopost)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 아래 경로들을 실제 Ubuntu 배포 경로로 변경하세요.
User=autopost
WorkingDirectory=/opt/autopost
EnvironmentFile=/opt/autopost/.env
ExecStart=/opt/autopost/venv/bin/python /opt/autopost/main.py daemon
Restart=always
RestartSec=10
StandardOutput=append:/var/log/autopost/stdout.log
StandardError=append:/var/log/autopost/stderr.log

[Install]
WantedBy=multi-user.target

# ---- 설치 방법 (Ubuntu) ----
# sudo cp deploy/autopost.service /etc/systemd/system/autopost.service
# sudo mkdir -p /var/log/autopost
# sudo systemctl daemon-reload
# sudo systemctl enable --now autopost.service
# sudo systemctl status autopost.service
#
# 주의: 이 파일은 Windows 개발 환경에서 직접 실행/검증할 수 없는 배포 전용
# 템플릿입니다. 실제 Ubuntu 서버에 배포하기 전 경로(User/WorkingDirectory/
# EnvironmentFile/ExecStart)를 반드시 확인하세요.
