# ============================================================
# 3사이트 통합 패시브 미디어 파이프라인 - 환경변수 예시
# 이 파일을 복사해 .env로 저장한 뒤 실제 값을 채워 넣으세요.
# .env 파일은 절대 git에 커밋하지 마세요.
# ============================================================

# ---- 공통 ----
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
SCHEDULE_TIME=07:00
PEXELS_API_KEY=
GOOGLE_KEY_PATH=service_account.json
# 텔레그램 승인 카드를 보낸 뒤 이 시간(시간 단위) 동안 승인/반려가 없으면 자동으로
# 발행한다 (daemon이 켜져 있을 때만 체크됨 - 버튼 콜백과 동일한 전제).
AUTO_PUBLISH_TIMEOUT_HOURS=24

# ---- 뉴스레터 (Resend) ----
RESEND_API_KEY=
SENDER_EMAIL=newsletter@your-domain.com
NEWSLETTER_SCHEDULE_TIME=Monday 08:00

# ---- 네이버 / 공공데이터포털 ----
# 2026년 네이버 검색 API는 NAVER API HUB(NAVER Cloud Platform)로 이관되었습니다.
# 기존 "네이버 개발자센터"가 아니라 https://www.ncloud.com/product/applicationService/naverApiHub
# 콘솔에서 발급받은 Key ID/Key를 넣으세요 (신규 애플리케이션은 개발자센터 방식 발급 자체가 불가합니다).
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
PUBLIC_DATA_API_KEY=

# ---- 쿠팡 파트너스 (선택) ----
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# ---- 애드픽 (선택) - 캠페인 리스트 API용 회원 식별자(affid, adpick.co.kr 대시보드에서 확인) ----
ADPICK_AFFID=

# ---- 소셜 배포 API ----
THREADS_ACCESS_TOKEN=
IG_ACCESS_TOKEN=
IG_USER_ID=
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# ---- YouTube (google-api-python-client OAuth 클라이언트 별도 필요) ----
YOUTUBE_CLIENT_SECRETS_PATH=client_secret.json
YOUTUBE_TOKEN_PATH=youtube_token.json
# YOUTUBE_API_KEY: 업로드용 OAuth와는 별개인 "단순 API 키"입니다.
# Google Cloud Console(같은 프로젝트) > API 및 서비스 > 사용자 인증 정보 >
# "사용자 인증 정보 만들기" > "API 키" 로 발급받으세요 (동의 화면 불필요, 훨씬 간단함).
# 최근 조회수 상위 관련 영상 검색(트렌드 참고)에만 사용되며 없어도 파이프라인은 정상 동작합니다.
YOUTUBE_API_KEY=

# ---- Site A: 정부지원금 ----
WP_A_URL=https://site-a.example.com
WP_A_USER=
WP_A_PASS=
AFF_A_LOAN=https://example.com/aff/loan
AFF_A_WELFARE=https://example.com/aff/welfare

# ---- Site B: 통신비/렌탈 비교 ----
WP_B_URL=https://site-b.example.com
WP_B_USER=
WP_B_PASS=
AFF_B_MVNO=https://example.com/aff/mvno
AFF_B_RENTAL=https://example.com/aff/rental
AFF_B_INTERNET=https://example.com/aff/internet

# ---- Site C: 세금환급/연금 ----
WP_C_URL=https://site-c.example.com
WP_C_USER=
WP_C_PASS=
AFF_C_REFUND=https://example.com/aff/refund
AFF_C_PENSION=https://example.com/aff/pension
